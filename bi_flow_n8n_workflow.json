    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/api/v1/agent6/comex-synthesis",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"dataset_name\": $('Node 2: POST /api/v1/agent5/map-and-query').first().json.dataset_name,\n  \"detected_domain\": $('Node 2: POST /api/v1/agent5/map-and-query').first().json.detected_domain,\n  \"retrieval_confidence\": $('Node 2: POST /api/v1/agent5/map-and-query').first().json.retrieval_relevance_score,\n  \"duckdb_proofs\": $('Node 2: POST /api/v1/agent5/map-and-query').first().json.duckdb_proofs,\n  \"statistical_anomalies\": $('Node 3: POST /api/v1/agent6/detect-anomalies').first().json.anomalies\n}",
        "options": {}
      },
      "id": "1e11a3b5-4b02-4871-9876-000000000006",
      "name": "Node 4: POST /api/v1/agent6/comex-synthesis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 380]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $('Node 3: POST /api/v1/agent6/detect-anomalies').first().json.has_critical_risk }}",
              "value2": true
            }
          ]
        }
      },
      "id": "1e11a3b5-4b02-4871-9876-000000000007",
      "name": "Critical Anomaly Detected?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1360, 380]
    },
    {
      "parameters": {
        "jsCode": "const node2 = $('Node 2: POST /api/v1/agent5/map-and-query').first().json;\nconst node3 = $('Node 3: POST /api/v1/agent6/detect-anomalies').first().json;\nconst node4 = $('Node 4: POST /api/v1/agent6/comex-synthesis').first().json;\n\nconst crit = node3.anomalies.find(a => a.severity === 'critical') || node3.anomalies[0];\nconst kpi = node2.duckdb_proofs[0];\n\nconst alertHeader = '🚨 [ALERTE CRITIQUE DIRECTION COMMERCIALE]\\n\\n';\nconst message = `${alertHeader}` +\n  `Dataset : ${node2.dataset_name} (Domaine: ${node2.detected_domain})\\n` +\n  `Score RAG Calibre : ${(node2.retrieval_relevance_score * 100).toFixed(1)}%\\n` +\n  `Metrique Principale : ${kpi ? kpi.kpi_name + ' = ' + kpi.value + ' ' + (kpi.unit || '') : 'N/A'}\\n\\n` +\n  `Anomalie Critique : ${crit ? crit.entity + ' (' + crit.metric + ' = ' + crit.observed_value + ' $)' : 'None'}\\n` +\n  `Diagnostic : ${crit ? crit.description : ''}\\n\\n` +\n  `Preuve SQL DuckDB (:memory:) :\\n${kpi ? kpi.exact_sql : 'N/A'}\\n\\n` +\n  `Synthese Executive Ancree :\\n${node4.executive_narrative}`;\n\nreturn { json: { status: 'ALERT_TRIGGERED', alert_message: message, kpi, anomaly: crit, synthesis: node4 } };"
      },
      "id": "1e11a3b5-4b02-4871-9876-000000000008",
      "name": "Build Critical Risk Alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1600, 260]
    },
    {
      "parameters": {
        "jsCode": "const node2 = $('Node 2: POST /api/v1/agent5/map-and-query').first().json;\nconst node4 = $('Node 4: POST /api/v1/agent6/comex-synthesis').first().json;\nconst kpi = node2.duckdb_proofs[0];\n\nconst header = '✅ [RAPPORT BI STANDARD COMEX]\\n\\n';\nconst message = `${header}` +\n  `Dataset : ${node2.dataset_name}\\n` +\n  `Score RRF & Rerank : ${(node2.retrieval_relevance_score * 100).toFixed(1)}%\\n` +\n  `Metrique : ${kpi ? kpi.kpi_name + ' = ' + kpi.value : 'N/A'}\\n\\n` +\n  `Preuve SQL DuckDB : ${kpi ? kpi.exact_sql : 'N/A'}\\n\\n` +\n  `Synthese :\\n${node4.executive_narrative}`;\n\nreturn { json: { status: 'NOMINAL', report_message: message, kpi, synthesis: node4 } };"
      },
      "id": "1e11a3b5-4b02-4871-9876-000000000009",
